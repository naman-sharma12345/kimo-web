{
  "name": "kimo-web",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @kimo/web dev",
    "mock": "pnpm --filter @kimo/mock-server dev",
    "mock:demo": "pnpm --filter @kimo/mock-server demo",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "pnpm --filter @kimo/web build",
    "e2e": "playwright test --grep-invert screenshots",
    "shots": "playwright test e2e/screenshots.spec.ts",
    "postinstall": "node scripts/grain.mjs && node scripts/fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@playwright/test": "^1.51.0",
    "@axe-core/playwright": "^4.10.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.14",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript-eslint": "^8.26.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "jsdom": "^26.0.0"
  }
}
