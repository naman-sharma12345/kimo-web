# Public build-time API base. /v1/... is appended after an optional path prefix.
# Development mock values only, not production endpoints.
NEXT_PUBLIC_KIMO_API=http://localhost:8787
# Origin-only override: replaces scheme/host/port of backend-issued session wsUrl.
# The session URL supplies its entire raw path/query/token; never put tokens here.
NEXT_PUBLIC_KIMO_WS=ws://localhost:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production requires explicit HTTPS API and WSS origin; rebuild on public changes.
# Missing production configuration fails clearly, never falls back to localhost.
# Backend must approve socket routing, cookie scope, CORS and auth/CSRF behavior.

# Optional server-only transport for the SAME typed API (e.g. synthetic runner).
# KIMO_API_INTERNAL_URL=http://127.0.0.1:8790
# Explicit approved transport origin for request-scoped SSR Cookie forwarding.
# Absence sends no Cookie header; mismatch fails. Never use wildcard/path/query.
# KIMO_SSR_COOKIE_ORIGIN=https://approved-service.example
# API-host-only cookies absent from the app request cannot be forwarded by SSR.
# No OAuth secrets, credentials or quota/retention policy belongs in public env.

# Optional approved identity-free collectors. Unset means no telemetry/error requests.
# NEXT_PUBLIC_KIMO_TELEMETRY_URL=https://approved-collector.example/events
# NEXT_PUBLIC_KIMO_ERROR_REPORT_URL=https://approved-collector.example/errors
# These are collector contracts, not direct PostHog/Sentry DSNs or credentials.
# Explicit comma-separated HTTPS origins for CSP, never wildcard buckets/collectors.
# KIMO_MEDIA_ORIGINS=https://approved-media.example
# KIMO_TELEMETRY_ORIGINS=https://approved-collector.example
